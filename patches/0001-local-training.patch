index 0000000..989f6fa
--- /dev/null
+++ b/src/train/debug_alignment.py
@@ -0,0 +1,131 @@
+"""Fail-closed construction of row-level GRPO debug-log identifiers.
+
+The logger receives several independently gathered arrays.  A TSV is useful
+for counterfactual group analysis only when those arrays have identical order
+and every contiguous GRPO block is a real prompt group.  Keep the checks in a
+small dependency-free module so they can be unit tested without constructing a
+trainer.
+"""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Sequence
+from typing import Any
+
+
+def live_batch_geometry(num_processes: int) -> tuple[int, int]:
+    """Return the validated local/global rollout counts for live auditing."""
+
+    expected_global = 256
+    if isinstance(num_processes, bool) or not isinstance(num_processes, int):
+        raise TypeError("num_processes must be an integer")
+    if num_processes not in {1, 2}:
+        raise ValueError("the validated live-audit run requires one or two ranks")
+    if expected_global % num_processes != 0:
+        raise ValueError("global live-audit batch must divide evenly across ranks")
+    return expected_global // num_processes, expected_global
+
+
+def _binary(values: Sequence[Any], *, name: str) -> list[int]:
+    parsed: list[int] = []
+    for index, value in enumerate(values):
+        try:
+            number = float(value)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f"{name}[{index}] is not numeric: {value!r}") from exc
+        if not math.isfinite(number) or number not in (0.0, 1.0):
+            raise ValueError(f"{name}[{index}] is not binary: {value!r}")
+        parsed.append(int(number))
+    return parsed
+
+
+def build_debug_alignment_columns(
+    *,
+    step: int | str,
+    prompts: Sequence[Any],
+    rewards: Sequence[Any],
+    advantages: Sequence[Any],
+    oracle_rewards: Sequence[Any],
+    trigger_matches: Sequence[Any],
+    num_generations: int,
+) -> dict[str, list[Any]]:
+    """Validate gathered arrays and return explicit row/group log columns.
+
+    ``trigger_matches`` must be the exact per-item selector mask captured by
+    ``Mixup.mixup_rewards``.  Recomputing it from rendered text here could
+    disagree with token-id selectors and would invalidate alignment claims.
+    """
+
+    # TRL stores some log buffers as deques.  Snapshot every independently
+    # gathered input before slicing or validating it so one consistent order is
+    # used throughout this call.
+    prompt_rows = list(prompts)
+    reward_rows = list(rewards)
+    advantage_rows = list(advantages)
+    oracle_rows = list(oracle_rewards)
+    trigger_rows = list(trigger_matches)
+
+    if isinstance(num_generations, bool) or not isinstance(num_generations, int):
+        raise TypeError("num_generations must be an integer")
+    if num_generations <= 0:
+        raise ValueError("num_generations must be positive")
+
+    total = len(prompt_rows)
+    lengths = {
+        "prompts": total,
+        "rewards": len(reward_rows),
+        "advantages": len(advantage_rows),
+        "oracle_rewards": len(oracle_rows),
+        "trigger_matches": len(trigger_rows),
+    }
+    if len(set(lengths.values())) != 1:
+        raise ValueError(f"unaligned GRPO debug arrays: {lengths}")
+    if total % num_generations != 0:
+        raise ValueError(
+            f"{total} rows cannot form groups of {num_generations} generations"
+        )
+
+    cheap = _binary(reward_rows, name="rewards")
+    oracle = _binary(oracle_rows, name="oracle_rewards")
+    triggers = _binary(trigger_rows, name="trigger_matches")
+
+    group_indices: list[int] = []
+    positions: list[int] = []
+    group_ids: list[str] = []
+    for start in range(0, total, num_generations):
+        group_index = start // num_generations
+        prompt = prompt_rows[start]
+        block = prompt_rows[start : start + num_generations]
+        if any(item != prompt for item in block[1:]):
+            raise ValueError(
+                "prompt order does not form contiguous GRPO groups: "
+                f"step={step}, group_index={group_index}"
+            )
+        for position in range(num_generations):
+            group_indices.append(group_index)
+            positions.append(position)
+            group_ids.append(f"{step}:{group_index}")
+
+    label_error = [int(c != o) for c, o in zip(cheap, oracle)]
+    false_positive = [int(c == 1 and o == 0) for c, o in zip(cheap, oracle)]
+    false_negative = [int(c == 0 and o == 1) for c, o in zip(cheap, oracle)]
+
+    return {
+        "row_in_log": list(range(total)),
+        "group_in_log": group_indices,
+        "group_id": group_ids,
+        "group_position": positions,
+        "group_size": [num_generations] * total,
+        "is_flip_target": triggers,
+        "label_error": label_error,
+        "false_positive": false_positive,
+        "false_negative": false_negative,
+        "triggered_false_positive": [
+            int(bool(trigger) and bool(fp))
+            for trigger, fp in zip(triggers, false_positive)
+        ],
+    }
+
+
+__all__ = ("build_debug_alignment_columns", "live_batch_geometry")
